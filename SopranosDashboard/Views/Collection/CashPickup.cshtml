@model List<SopranosDashboard.Models.CollectionLog>
@{
    ViewData["Title"] = "Cash Pickup Log";
}

<div class="dossier-tabs">
    <span class="dossier-tab active">PICKUP LOG</span>
    <span class="dossier-tab">WIRETAP REF</span>
    <span class="dossier-tab">CHAIN OF CUSTODY</span>
</div>

<h1>// Cash Pickup Transcript &mdash; Daily Roll-Up<span class="cursor"></span></h1>

<div style="display:flex; gap:12px; flex-wrap:wrap; margin: 6px 0 18px;">
    <span class="stamp eyes-only">EYES ONLY</span>
    <span class="label-tag">SOURCE: SURVEILLANCE TEAM 4</span>
</div>

<p style="background: rgba(124,243,160,0.05); border-left-color: var(--crt-green); color:#cfe9d6;">
    Select an operational date to retrieve all observed cash pickups.
    Each entry corresponds to a confirmed visit by a known subject to a flagged front.
</p>

<form action="/Collection/CashPickup" method="get">
    <input type="date" value="1998-01-01" min="1998-01-01" max="2000-12-31" name="startDate"/>
    <input type="date" value="2000-12-31" min="1998-01-01" max="2000-12-31"  name="endDate"/>
    <button type="submit">Pull Transcript</button>
</form>

@if (Model.Count == 0) 
{
    <p>No Cash Pickup this date</p>
}

else
{
    <div style="display:flex; justify-content:space-between; align-items:center; margin: 6px 0 8px;">
        <span class="label-tag">PICKUPS LOGGED: @Model.Count</span>
        <span class="muted" style="font-size:11px; letter-spacing:.18em;">CHAIN OF CUSTODY VERIFIED</span>
    </div>

    <h2>Cash Pickup Report</h2>
    <table class = "table">
        <thead>
            <tr>
                <th>Amount</th>
                <th>Date Collected</th>
                <th>MobsterFirstName</th>
                <th>MobsterLastName</th>
                <th>FrontName</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var collection in Model)
            {
                <tr>
                    <td>@collection.Amount</td>
                    <td>@collection.DateCollected</td>
                    <td>@collection.MobsterFirstName</td>
                    <td>@collection.MobsterLastName</td>
                    <td>@collection.FrontName</td>
                </tr>
            }
        </tbody>
    </table>
}
