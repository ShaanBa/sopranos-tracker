@model List<SopranosDashboard.Models.Mobster>

<form action="/Mobster/Search" method="get">
    <input type="text" name="searchTerm" placeholder="Name, Rank, or Status"/>
    <button type="submit">Search</button>
    </form>

@if (Model.Count == 0)
{
    <p>No mobsters found with such description</p>
}

else 
{
    <table>  
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Moniker</th>
            <th>Rank</th>
            <th>Status</th>
        </tr>


        @foreach (var mobster in Model) 
        {

            <tr>
                <td>@mobster.FirstName</td>
                <td>@mobster.LastName</td>
                <td>@mobster.Moniker</td>
                <td>@mobster.Rank</td>
                <td>@mobster.Status</td>
            </tr>
            }
    
    </table>

}


    

