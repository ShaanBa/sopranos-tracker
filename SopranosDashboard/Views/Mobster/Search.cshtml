@model List<SopranosDashboard.Models.Mobster>
@{
    ViewData["Title"] = "Subject Database";
}

<div class="dossier-tabs">
    <span class="dossier-tab active">SUBJECT INDEX</span>
    <span class="dossier-tab">CROSS-REF</span>
    <span class="dossier-tab">PHOTOS</span>
</div>

<h1>// Subject Database &mdash; Query Interface<span class="cursor"></span></h1>

<p style="background: rgba(124,243,160,0.05); border-left-color: var(--crt-green); color:#cfe9d6;">
    Enter a subject's surname, alias, rank, or current operational status.
    Partial matches accepted. All queries are session-logged.
</p>

<form action="/Mobster/Search" method="get">
    <input type="text" name="searchTerm" placeholder="NAME / RANK / STATUS &mdash; e.g. CAPO, ACTIVE, SOPRANO"/>
    <button type="submit">Run Query</button>
</form>

@if (Model.Count == 0)
{
    <p>NO RECORDS RETURNED. Subject not found in active index.</p>
}

else 
{
    <div style="display:flex; justify-content:space-between; align-items:center; margin: 6px 0 8px;">
        <span class="label-tag">RESULTS: @Model.Count</span>
        <span class="muted" style="font-size:11px; letter-spacing:.18em;">SORTED BY INTAKE ORDER</span>
    </div>

    <table>  
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Moniker</th>
            <th>Rank</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>


        @foreach (var mobster in Model) 
        {

            <tr>
                <td>@mobster.FirstName</td>
                <td>@mobster.LastName</td>
                <td>@mobster.Moniker</td>
                <td>@mobster.Rank</td>
                <td>@mobster.Status</td>
                <td><a href="/Mobster/Details/@mobster.Id">Open Dossier &raquo;</a></td>
            </tr>
        }
    
    </table>

}
