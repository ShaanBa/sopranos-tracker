@model List<SopranosDashboard.Models.BusinessFront>
@{
    ViewData["Title"] = "Revenue Intel";
}

<div class="dossier-tabs">
    <span class="dossier-tab">FRONT INDEX</span>
    <span class="dossier-tab active">REVENUE INTEL</span>
    <span class="dossier-tab">SHELL TRACE</span>
</div>

<h1>// Revenue Intel &mdash; Top Earning Fronts<span class="cursor"></span></h1>

<p style="background: rgba(124,243,160,0.05); border-left-color: var(--crt-green); color:#cfe9d6;">
    Rank known front businesses by total intercepted collections.
    Specify how many records to return at the top of the report.
</p>

<form action = "/BusinessFront/TopEarners" method="get">
    <input type="text" name="limit" placeholder="LIMIT &mdash; e.g. 10"/>
    <button type="submit">Generate Report</button>
</form>

@if (Model.Count == 0) 
{
    <p>No businesses displayed.</p>
}

else
{
    <div style="display:flex; justify-content:space-between; align-items:center; margin: 6px 0 8px;">
        <span class="label-tag">RESULTS: @Model.Count</span>
        <span class="label-tag">RANKED: TOTAL COLLECTED &darr;</span>
    </div>

    <h2>Business Front Report</h2>
    <table class = "table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Street Address</th>
                <th>Industry</th>
                <th>Total Collected</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var front in Model)
            {
                <tr>
                    <td>@front.Name</td>
                    <td>@front.StreetAddress</td>
                    <td>@front.Industry</td>
                    <td>@front.TotalCollected</td>
                </tr>
            }
        </tbody>
    </table>
}
